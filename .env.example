# Resend API Key for email notifications
# Gmail Configuration (for sending emails without a domain)
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-character password and use it as EMAIL_PASS
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Madar SMS Configuration (Saudi Arabia)
MADAR_SMS_USERNAME=
MADAR_SMS_PASSWORD=
MADAR_SMS_SENDER=

# Odoo Integration
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=aburiyad
ODOO_PASSWORD=test
ODOO_WEBHOOK_SECRET=your_secret_here
FRONTEND_ORIGIN=https://your-netlify-site.netlify.app

# Frontend -> Backend API base (set this in hosting env, e.g. Netlify)
VITE_API_BASE_URL=https://your-backend-domain.com

# Firebase Admin SDK credentials (required for sync-odoo.ts and server.ts on local machine)
# Download service account JSON from Firebase Console > Project Settings > Service accounts
# then set absolute path to that file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
