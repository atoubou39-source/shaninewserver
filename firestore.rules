rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == "atoubou39@gmail.com" || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidImageUrl(url) {
      return url is string && (
        url.matches("^https://.*") || 
        url.matches("^http://.*") || 
        url.matches("^data:image/.*;base64,.*")
      ) && url.size() < 1048576; // Less than 1MB
    }

    // ===============================================================
    // Entity Validations
    // ===============================================================

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'image']) &&
             data.id is number &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is string && data.price.size() > 0 && data.price.size() < 100 &&
             isValidImageUrl(data.image) &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'email', 'phone1', 'address', 'city', 'district', 'paymentMethod', 'items', 'total', 'status', 'createdAt']) &&
             data.customerName is string && data.customerName.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.phone1 is string && data.phone1.size() > 0 &&
             data.address is string && data.address.size() > 0 &&
             data.paymentMethod in ['cod', 'bank_transfer'] &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status in ['pending_approval', 'pending_payment', 'approved', 'processing', 'shipped', 'completed', 'cancelled', 'rejected', 'refunded'] &&
             data.createdAt is string;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['facilityName', 'phoneNumber', 'role']) &&
             data.facilityName is string && data.facilityName.size() > 0 && data.facilityName.size() < 200 &&
             data.phoneNumber is string && data.phoneNumber.size() > 0 &&
             data.role in ['admin', 'customer'];
    }

    function isValidSEO(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 500 &&
             data.keywords is string;
    }

    // ===============================================================
    // Collection Matches
    // ===============================================================

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow get: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && (isAdmin() || (request.auth.token.activated == true && request.auth.token.odooCustomer == true)) && isValidOrder(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if false; // Only via backend webhook
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Customers collection
    match /customers/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // Settings collection
    match /settings/seo {
      allow read: if true;
      allow write: if isAdmin() && 
                    isValidSEO(incoming().home) &&
                    isValidSEO(incoming().collection) &&
                    isValidSEO(incoming().about);
    }
  }
}
